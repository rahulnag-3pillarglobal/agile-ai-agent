{
  "agents": {
    "project-pilot": ".agile-ai-agent/agents/project-pilot.md",
    "scrum-buddy": ".agile-ai-agent/agents/scrum-buddy.md",
    "spec-writer": ".agile-ai-agent/agents/spec-writer.md",
    "dev-crafter": ".agile-ai-agent/agents/dev-crafter.md",
    "qa-guardian": ".agile-ai-agent/agents/qa-guardian.md",
